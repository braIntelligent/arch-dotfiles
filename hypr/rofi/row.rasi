/* Fila horizontal de tarjetas (layout de gh0stzk: PowerMenu/Screenshot.rasi).
   Cada applet ajusta columnas, ancho e icono con -theme-str. */
configuration {
    hover-select:    true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    /* moverse con h j k l ademas de las flechas */
    kb-row-left:  "Control+Page_Up,h";
    kb-row-right: "Control+Page_Down,l";
    kb-row-up:    "Up,Control+p,k";
    kb-row-down:  "Down,Control+n,j";
}

/* valores por si colors.rasi aun no trae estos colores */
* { green: #73daca; red: #f7768e; }
@import "colors.rasi"

* { background-color: transparent; text-color: @fg; font: "Hack Nerd Font 12"; }
window {
    width: 1000px;
    location: center;
    background-color: @bg;
    border: 2px; border-color: @blue; border-radius: 14px;
}
mainbox {
    spacing: 14px;
    padding: 22px;
    children: [ inputbar, message, listview ];
}
inputbar { spacing: 10px; children: [ textbox-prompt-colon, prompt ]; }
textbox-prompt-colon {
    expand: false;
    str: "";
    padding: 10px 16px 10px 14px;
    border-radius: 8px;
    background-color: @red;
    text-color: @bg-alt;
}
prompt {
    padding: 10px 14px;
    border-radius: 8px;
    background-color: @green;
    text-color: @bg-alt;
}
message {
    padding: 10px 14px;
    border-radius: 8px;
    background-color: @bg-alt;
}
textbox { text-color: @fg; }
listview {
    layout: vertical;
    columns: 5;
    lines: 1;
    fixed-columns: true;
    cycle: true;
    spacing: 12px;
    scrollbar: false;
}
element {
    padding: 26px 6px;
    border: 1px; border-color: @blue; border-radius: 10px;
    background-color: @bg;
}
element-text { horizontal-align: 0.5; vertical-align: 0.5; text-color: inherit; }
element selected { background-color: @blue; text-color: @bg-alt; }
