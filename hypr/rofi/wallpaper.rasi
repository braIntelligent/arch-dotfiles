/* Tira horizontal de miniaturas, centrada (layout de gh0stzk: WallSelect.rasi) */
configuration {
    /* moverse con h j k l ademas de las flechas */
    kb-row-left:  "Control+Page_Up,h";
    kb-row-right: "Control+Page_Down,l";
    kb-row-up:    "Up,Control+p,k";
    kb-row-down:  "Down,Control+n,j";
}

@import "colors.rasi"

* { background-color: transparent; text-color: @fg; }
window {
    width: 90%;
    location: center;
    background-color: @bg;
    border: 2px; border-color: @blue; border-radius: 14px;
}
mainbox { children: [ listview ]; }
listview {
    layout: vertical;
    columns: 6;
    lines: 1;
    fixed-columns: true;
    cycle: true;
    spacing: 24px;
    padding: 20px 30px;
    scrollbar: false;
}
element {
    orientation: vertical;
    padding: 6px;
    border-radius: 16px;
}
element-icon { size: 180px; horizontal-align: 0.5; }
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    padding: 8px 0px 6px 0px;
    text-color: inherit;
}
element selected { background-color: @blue; text-color: @bg-alt; }
