// Definicion de todos los modulos. La comparten config.jsonc (normal) y htb.jsonc.
// Es una plantilla: set-theme.sh cambia cada @color@ por el del tema activo y
// escribe el resultado en ~/.config/waybar/modulos.jsonc.
{
    // clic en el logo: cambia entre la barra normal y la de HTB
    "custom/arch": { "format": "", "tooltip": false, "on-click": "~/.config/hypr/scripts/barra.sh cambiar" },
    // aparece solo mientras se graba la pantalla; clic: detener
    "custom/grabando": {
        "exec": "~/.config/waybar/scripts/grabando.sh",
        "interval": "once", "signal": 8, "tooltip": false,
        "on-click": "~/.config/hypr/scripts/grabar.sh"
    },
    "custom/ip":     { "exec": "~/.config/waybar/scripts/ip.sh",     "interval": 2, "tooltip": false },
    "custom/vpn":    { "exec": "~/.config/waybar/scripts/vpn.sh",    "interval": 2, "tooltip": false },
    "custom/target": { "exec": "~/.config/waybar/scripts/target.sh", "interval": 2, "tooltip": false },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "empty": "", "default": "", "active": "" },
        "persistent-workspaces": { "*": 5 }
    },

    "cpu":    { "interval": 2, "format": "<span color='@yellow@'></span>  {usage}%", "tooltip": false },
    "memory": { "interval": 2, "format": "<span color='@magenta@'>󰍛</span>  {percentage}%", "tooltip": false },

    // rueda del mouse sobre el modulo: sube o baja el brillo
    "backlight": {
        "device": "apple-panel-bl",
        "format": "<span color='@yellow@'></span>  {percent}%",
        "on-scroll-up":   "brightnessctl -q -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -q -e4 -n2 set 5%-",
        "tooltip": false
    },

    // rueda: volumen; clic: silenciar
    "wireplumber": {
        "format": "<span color='@cyan@'>{icon}</span>  {volume}%",
        "format-muted": "<span color='@dim@'>  mudo</span>",
        "format-icons": ["", ""],
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{node_name}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "<span color='@blue@'></span>  {essid}",
        "max-length": 22,
        "format-ethernet": "<span color='@blue@'></span>  cable",
        "format-disconnected": "<span color='@dim@'>  sin wifi</span>",
        "tooltip-format-wifi": "{signalStrength}%  {frequency} GHz  {ipaddr}",
        "tooltip-format": "{ifname}  {ipaddr}"
    },

    "battery": {
        "bat": "macsmc-battery",
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='@green@'>{icon}</span>  {capacity}%",
        "format-warning": "<span color='@yellow@'>{icon}</span>  {capacity}%",
        "format-critical": "<span color='@red@'>{icon}</span>  {capacity}%",
        "format-charging": "<span color='@green@'></span>  {capacity}%",
        "format-plugged": "<span color='@green@'></span>  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // clic: alterna entre la hora y la fecha
    "clock": {
        "format": "<span color='@magenta@'></span>  {:%H:%M}",
        "format-alt": "<span color='@magenta@'></span>  {:%a %d %b}",
        "tooltip": false
    },

    // clic: abre bluetui para emparejar o conectar
    "bluetooth": {
        "format": "<span color='@blue@'></span>",
        "format-connected": "<span color='@blue@'></span>  {device_alias}",
        "format-off": "<span color='@dim@'></span>",
        "format-disabled": "<span color='@dim@'></span>",
        "format-no-controller": "",
        "max-length": 20,
        "on-click": "~/.config/hypr/scripts/bluetooth.sh",
        "tooltip-format": "{controller_alias}  {num_connections} conectados"
    }
}
